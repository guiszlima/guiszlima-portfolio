{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["meta", "profile", "projects", "skills", "experience"],
  "properties": {
    "meta": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "updatedAt"], "properties": { "schemaVersion": { "type": "string" }, "updatedAt": { "type": "string", "format": "date" } } },
    "profile": { "type": "object", "additionalProperties": true, "required": ["name", "monogram", "role", "tagline", "availability", "location", "about", "email", "links"] },
    "projects": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "category", "status", "year", "summary", "description", "technologies", "highlights"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "title": { "type": "string" }, "category": { "$ref": "#/$defs/localized" }, "status": { "enum": ["active", "completed", "maintenance", "archived"] }, "year": { "type": "string" }, "summary": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" }, "technologies": { "type": "array", "items": { "type": "string" } }, "highlights": { "type": "array", "items": { "$ref": "#/$defs/localized" } }, "repositoryUrl": { "type": "string", "format": "uri" }, "demoUrl": { "type": "string", "format": "uri" } } } },
    "skills": { "type": "array", "items": { "type": "object", "required": ["id", "name", "category"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "category": { "$ref": "#/$defs/localized" }, "level": { "type": "string" } } } },
    "experience": { "type": "array", "items": { "type": "object", "required": ["id", "company", "role", "period", "summary", "technologies"], "properties": { "id": { "type": "string" }, "company": { "type": "string" }, "role": { "$ref": "#/$defs/localized" }, "period": { "$ref": "#/$defs/localized" }, "summary": { "$ref": "#/$defs/localized" }, "technologies": { "type": "array", "items": { "type": "string" } } } } }
  },
  "$defs": { "localized": { "type": "object", "additionalProperties": false, "required": ["pt", "en"], "properties": { "pt": { "type": "string" }, "en": { "type": "string" } } } }
}
